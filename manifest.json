{
  "manifest_version": 3,
  "name": "Site Label",
  "version": "1.9.0",
  "description": "Label environments with a colour-coded ribbon or bar so you never mistake UAT for Production. Built for D365, Salesforce, SAP and any web app.",
  "author": "Site Label",
  "minimum_chrome_version": "108",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "action": {
    "default_title": "Site Label",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },

  "background": {
    "service_worker": "src/background/service-worker.js"
  },

  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "contextMenus"
  ],

  "optional_host_permissions": [
    "*://*/*"
  ],

  "commands": {
    "toggle-label": {
      "suggested_key": { "default": "Alt+Shift+L" },
      "description": "Show or hide the label on this tab"
    },
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open the Site Label popup"
    }
  },

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'"
  }
}
